# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Table prefix (multi-tenant — prefixes all Supabase table names)
NEXT_PUBLIC_TABLE_PREFIX=

# Venture slug — stamped into user_metadata so the shared auth-bridge can
# resolve which venture an auth email belongs to (VOS-104 send-email hook)
NEXT_PUBLIC_VENTURE_SLUG=

# Resend (email)
RESEND_API_KEY=re_your_key

# Sending domain for emails (defaults to venture-os.co)
SENDING_DOMAIN=venture-os.co

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Stripe Price IDs (create in Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_pro_monthly_id
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_id

# Inngest (drip email campaigns)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Site URL (used in sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
