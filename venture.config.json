{
  "name": "{{PRODUCT_NAME}}",
  "tagline": "{{TAGLINE}}",
  "description": "{{DESCRIPTION}}",
  "domain": "{{DOMAIN}}",
  "layout": "centered",
  "flags": {
    "waitlistMode": true,
    "mvpReady": false
  },
  "brand": {
    "primary": "#3b82f6",
    "primaryDark": "#2563eb",
    "accent": "#8b5cf6",
    "gradient": "from-blue-600 to-violet-600",
    "gradientHover": "from-blue-500 to-violet-500",
    "surface": "#0A0A0F",
    "surfaceLight": "#111118"
  },
  "landing": {
    "headline": "{{HEADLINE}}",
    "subheadline": "{{SUBHEADLINE}}",
    "primaryCta": "Join Waitlist",
    "secondaryCta": "View Pricing",
    "navCta": "Get Early Access",
    "waitlistCardTitle": "Get early access",
    "waitlistCardSubtitle": "Be among the first to try {{PRODUCT_NAME}}.",
    "finalCtaButton": "Join the Waitlist",
    "painStats": [
      { "stat": "{{STAT_1}}", "label": "{{STAT_1_LABEL}}" },
      { "stat": "{{STAT_2}}", "label": "{{STAT_2_LABEL}}" },
      { "stat": "{{STAT_3}}", "label": "{{STAT_3_LABEL}}" }
    ],
    "steps": [
      { "title": "{{STEP_1}}", "desc": "{{STEP_1_DESC}}" },
      { "title": "{{STEP_2}}", "desc": "{{STEP_2_DESC}}" },
      { "title": "{{STEP_3}}", "desc": "{{STEP_3_DESC}}" }
    ],
    "painPoints": [
      "{{PAIN_1}}",
      "{{PAIN_2}}",
      "{{PAIN_3}}",
      "{{PAIN_4}}",
      "{{PAIN_5}}",
      "{{PAIN_6}}"
    ],
    "pricing": [
      {
        "plan": "Starter",
        "price": "Free",
        "period": "",
        "desc": "{{STARTER_DESC}}",
        "features": ["{{STARTER_F1}}", "{{STARTER_F2}}", "{{STARTER_F3}}", "{{STARTER_F4}}"],
        "highlighted": false
      },
      {
        "plan": "Pro",
        "price": "{{PRO_PRICE}}",
        "period": "/mo",
        "desc": "{{PRO_DESC}}",
        "features": ["{{PRO_F1}}", "{{PRO_F2}}", "{{PRO_F3}}", "{{PRO_F4}}", "{{PRO_F5}}", "{{PRO_F6}}"],
        "highlighted": true
      },
      {
        "plan": "Enterprise",
        "price": "Custom",
        "period": "",
        "desc": "{{ENTERPRISE_DESC}}",
        "features": ["Everything in Pro", "{{ENT_F1}}", "{{ENT_F2}}", "{{ENT_F3}}", "{{ENT_F4}}"],
        "highlighted": false
      }
    ],
    "finalCta": {
      "headline": "{{FINAL_CTA_HEADLINE}}",
      "subheadline": "{{FINAL_CTA_SUB}}"
    }
  },
  "experiments": {
    "landingPage": {
      "key": "landing_page_v1",
      "cookieName": "vo_exp_landing_page_v1",
      "variants": [
        {
          "key": "control",
          "weight": 0.5,
          "overrides": {
            "headline": "{{HEADLINE}}",
            "subheadline": "{{SUBHEADLINE}}",
            "primaryCta": "Join Waitlist",
            "navCta": "Get Early Access",
            "secondaryCta": "View Pricing",
            "finalCta": {
              "headline": "{{FINAL_CTA_HEADLINE}}",
              "subheadline": "{{FINAL_CTA_SUB}}"
            }
          }
        },
        {
          "key": "variant_b",
          "weight": 0.5,
          "overrides": {
            "headline": "{{ALT_HEADLINE}}",
            "subheadline": "{{ALT_SUBHEADLINE}}",
            "primaryCta": "Get Early Access",
            "navCta": "See It First",
            "secondaryCta": "See Pricing",
            "finalCta": {
              "headline": "{{ALT_FINAL_CTA_HEADLINE}}",
              "subheadline": "{{ALT_FINAL_CTA_SUB}}"
            }
          }
        }
      ]
    }
  },
  "analytics": {
    "provider": "posthog",
    "errorMonitoring": "sentry",
    "northStarMetric": "waitlist_signup_succeeded",
    "secondaryMetrics": ["signup_completed", "subscription_started"],
    "attributionProperties": ["utm_source", "utm_medium", "utm_campaign", "referrer", "country", "device_type"],
    "events": {
      "page_view": "page_view",
      "landing_page_view": "landing_page_view",
      "experiment_exposure": "experiment_exposure",
      "landing_cta_clicked": "landing_cta_clicked",
      "waitlist_signup_submitted": "waitlist_signup_submitted",
      "waitlist_signup_succeeded": "waitlist_signup_succeeded",
      "signup_started": "signup_started",
      "signup_completed": "signup_completed",
      "dashboard_viewed": "dashboard_viewed",
      "checkout_started": "checkout_started",
      "subscription_started": "subscription_started"
    }
  },
  "dashboard": {
    "navItems": [
      { "label": "Dashboard", "href": "/dashboard", "icon": "LayoutDashboard" },
      { "label": "{{NAV_1}}", "href": "/dashboard/{{NAV_1_SLUG}}", "icon": "{{NAV_1_ICON}}" },
      { "label": "{{NAV_2}}", "href": "/dashboard/{{NAV_2_SLUG}}", "icon": "{{NAV_2_ICON}}" },
      { "label": "Settings", "href": "/dashboard/settings", "icon": "Settings" }
    ]
  }
}
